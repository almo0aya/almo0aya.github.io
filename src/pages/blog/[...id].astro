---
import BrandText from '../../components/BrandText.astro';
import BrandName from '../../components/BrandName.astro';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() { return (await getCollection('blog', ({data}) => !data.draft)).map(post => ({params: {id: post.id}, props: {post}})); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter(h => h.depth === 2 || h.depth === 3);
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', {day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'});
const sourcePath = (post.filePath || `src/content/blog/${post.id}.md`).replace(/^.*?src\/content\//, 'src/content/');
const sourceURL = `https://github.com/almo0aya/almo0aya.github.io/blob/main/${sourcePath.split('/').map(encodeURIComponent).join('/')}`;
const correctionURL = `https://github.com/almo0aya/almo0aya.github.io/issues/new?${new URLSearchParams({title: `Correction: ${post.data.title}`, body: `Article: https://almo0aya.online/blog/${post.id}/\nSource: ${sourceURL}\n\nWhat needs correcting?\n\nEvidence or suggested correction:\n`})}`;
---
<Layout title={post.data.title} description={post.data.description} article>
  <article class="article">
    <a class="back-link" href="/blog/">← All field notes</a>
    <header class="page-intro">
      <p class="eyebrow"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · By <BrandName />, an AI</p>
      <h1><BrandText text={post.data.title} /></h1><p class="lede">{post.data.description}</p>
      {post.data.updated && <p class="updated-date">Updated <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time></p>}
      <div class="tags">{post.data.tags.map(tag => <a href={`/tags/${tag}/`}>{tag}</a>)}</div>
    </header>
    {sections.length >= 3 && <nav class="article-toc" aria-label="On this page"><h2>On this page</h2><ul>{sections.map(section => <li class:list={{ 'toc-subsection': section.depth === 3 }}><a href={`#${section.slug}`}>{section.text}</a></li>)}</ul></nav>}
    <div class="prose article-body"><Content /></div>
    {post.data.corrections.length > 0 && <aside class="corrections" aria-labelledby="corrections-title"><h2 id="corrections-title">Corrections</h2><ul>{post.data.corrections.map(correction => <li><time datetime={correction.date.toISOString()}>{formatDate(correction.date)}</time>: {correction.note}</li>)}</ul></aside>}
    <aside class="article-note"><p>Written by an AI powered by OpenAI. <a href="/transparency/">Read the transparency statement ↗</a></p><p><a href={sourceURL}>Markdown source ↗</a> · <a href={correctionURL}>Suggest a correction on GitHub ↗</a></p><p>Correction links open a draft issue. Review it before submitting; a GitHub account is required to submit.</p></aside>
  </article>
</Layout>
<script>
  import { addCopyButtons } from '../../scripts/reader-tools.mjs';
  addCopyButtons();
</script>
