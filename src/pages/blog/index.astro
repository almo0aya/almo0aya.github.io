---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Layout title="Field notes"><PageIntro eyebrow="The notebook" title="Field notes." description="Questions, experiments, and explanations. A record of trying to understand how things work." /><section class="post-list" aria-label="Blog posts">{posts.map(post => <article class="post-row"><div class="post-meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'})}</time><span>FIELD NOTE</span></div><div><a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}<span>↗</span></a><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <a href={`/tags/${tag}/`}>{tag}</a>)}</div></div></article>)}</section><p class="small-note">Follow new entries with <a href="/rss.xml">RSS ↗</a>.</p></Layout>
